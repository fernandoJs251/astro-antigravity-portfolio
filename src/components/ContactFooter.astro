---
// Sección de Contacto y Footer con estética moderna en negro puro y paleta pastel
---

<footer id="contacto" class="contact-footer-section">
  <div class="container">
    <div class="contact-card glass-panel-glow">
      <div class="contact-header">
        <div class="section-badge">
          <span>📬 Conectemos</span>
        </div>
        <h2 class="contact-title">
          ¿Tienes un proyecto o idea en mente?
        </h2>
        <p class="contact-subtitle">
          Estoy disponible para colaboraciones, desarrollo de proyectos de software y nuevas oportunidades profesionales. ¡No dudes en escribirme!
        </p>
      </div>

      <!-- Quick Contact Buttons -->
      <div class="contact-methods-grid">
        <a 
          href="mailto:fernando.siles@gmail.com" 
          class="contact-method-card"
        >
          <div class="method-icon cyan">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <div class="method-info">
            <span class="method-label">Correo Electrónico</span>
            <span class="method-value">fernando.siles@gmail.com</span>
          </div>
        </a>

        <a 
          href="https://github.com/fernandoJSiles" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="contact-method-card"
        >
          <div class="method-icon violet">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </div>
          <div class="method-info">
            <span class="method-label">GitHub</span>
            <span class="method-value">@fernandoJSiles</span>
          </div>
        </a>

        <a 
          href="https://linkedin.com/in/fernando-siles" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="contact-method-card"
        >
          <div class="method-icon lime">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45c-.89 0-1.61.72-1.61 1.61s.72 1.61 1.61 1.61 1.61-.72 1.61-1.61-.72-1.61-1.61-1.61Z"/>
            </svg>
          </div>
          <div class="method-info">
            <span class="method-label">LinkedIn</span>
            <span class="method-value">Fernando Siles</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom">
      <div class="footer-copy">
        <span>© {new Date().getFullYear()} <strong>Fernando Siles</strong></span>
        <span class="footer-sep">•</span>
        <span>Estudiante de Ingeniería en Sistemas (5to Semestre)</span>
      </div>
      <div class="footer-built">
        <span>Diseñado con Astro, TypeScript & Modern CSS</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .contact-footer-section {
    padding: 80px 0 40px;
    position: relative;
    z-index: 2;
  }

  .contact-card {
    padding: 48px 36px;
    border-radius: 28px;
    background: linear-gradient(180deg, rgba(12, 14, 22, 0.95) 0%, rgba(6, 7, 12, 0.98) 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 32px;
  }

  .contact-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 650px;
  }

  .contact-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
  }

  .contact-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .contact-methods-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
    width: 100%;
    max-width: 900px;
  }

  .contact-method-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 22px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 16px;
    text-decoration: none;
    transition: all 0.25s ease;
    text-align: left;
  }

  .contact-method-card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(232, 249, 130, 0.35);
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
  }

  .method-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .method-icon.cyan {
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: #38bdf8;
  }

  .method-icon.violet {
    background: rgba(129, 140, 248, 0.1);
    border: 1px solid rgba(129, 140, 248, 0.25);
    color: #818cf8;
  }

  .method-icon.lime {
    background: rgba(232, 249, 130, 0.1);
    border: 1px solid rgba(232, 249, 130, 0.25);
    color: #E8F982;
  }

  .method-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .method-label {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .method-value {
    font-size: 0.88rem;
    font-weight: 600;
    color: #ffffff;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .footer-sep {
    margin: 0 6px;
    color: rgba(255, 255, 255, 0.2);
  }

  .footer-built {
    font-family: var(--font-mono);
    color: #E8F982;
    font-size: 0.76rem;
  }

  @media (max-width: 768px) {
    .contact-card {
      padding: 32px 20px;
    }

    .contact-title {
      font-size: 1.7rem;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
