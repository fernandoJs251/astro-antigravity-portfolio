</div>

<script>
  function initCvModal() {
    const cvBackdrop = document.getElementById('cv-modal');
    const cvCloseBtn = document.getElementById('cv-modal-close-btn');
    const cvCloseActionBtn = document.getElementById('cv-modal-close-action-btn');

    if (!cvBackdrop) return;

    function openCvModal() {
      cvBackdrop.classList.add('open');
      cvBackdrop.setAttribute('aria-hidden', 'false');
      document.body.classList.add('modal-open');
    }

    function closeCvModal() {
      cvBackdrop.classList.remove('open');
      cvBackdrop.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('modal-open');
    }

    // Export open function to window
    window.openCvModal = openCvModal;

    // 1. Close on "X" button
    cvCloseBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeCvModal();
    });

    // 2. Close on bottom action button
    cvCloseActionBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeCvModal();
    });

    // 3. Close on backdrop click outside container
    cvBackdrop.addEventListener('click', (e) => {
      if (e.target === cvBackdrop) {
        closeCvModal();
      }
    });

    // 4. Close on ESC key press
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && cvBackdrop.classList.contains('open')) {
        closeCvModal();
      }
    });

    // 5. Connect all triggers with class .js-open-cv-modal or attribute data-open-cv or href="#cv"
    document.querySelectorAll<HTMLElement>('.js-open-cv-modal, [data-open-cv], a[href="#cv"]').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openCvModal();
      });
    });
  }

  declare global {
    interface Window {
      openCvModal?: () => void;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCvModal);
  } else {
    initCvModal();
  }
</script>

<style>
  .cv-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .cv-modal-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  .cv-modal-container {
    width: 100%;
    max-width: 780px;
    max-height: 90vh;
    overflow-y: auto;
    border-radius: 26px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    transform: scale(0.92) translateY(20px);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background: rgba(8, 10, 15, 0.97);
    border: 1px solid rgba(232, 249, 130, 0.35);
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.95), 0 0 40px -10px rgba(232, 249, 130, 0.2);
  }

  .cv-modal-backdrop.open .cv-modal-container {
    transform: scale(1) translateY(0);
  }

  .cv-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .cv-user-badge {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .cv-avatar {
    position: relative;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: linear-gradient(135deg, #121622, #182030);
    border: 1.5px solid rgba(232, 249, 130, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 800;
    color: #E8F982;
    box-shadow: 0 0 15px rgba(232, 249, 130, 0.25);
  }

  .avatar-dot {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 11px;
    height: 11px;
    background: #E8F982;
    border-radius: 50%;
    border: 2px solid #000000;
    box-shadow: 0 0 8px #E8F982;
  }

  .cv-header-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cv-pre-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #E8F982;
  }

  .cv-name {
    font-size: 1.6rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .cv-role {
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .close-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-secondary);
    border-radius: 50%;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .close-btn:hover {
    background: rgba(232, 249, 130, 0.15);
    border-color: var(--accent-lime);
    color: #ffffff;
    transform: rotate(90deg) scale(1.05);
    box-shadow: 0 0 12px rgba(232, 249, 130, 0.3);
