---
// Barra de navegación fija con estética moderna, fondo negro puro y accesos directos
---

<nav class="navbar-wrapper" role="navigation" aria-label="Navegación principal">
  <div class="navbar-content glass-panel">
    <!-- Brand / Logo -->
    <a href="#inicio" class="nav-brand">
      <div class="brand-avatar">
        <span class="brand-letters">FS</span>
        <span class="online-indicator"></span>
      </div>
      <div class="brand-info">
        <span class="brand-name">Fernando Siles</span>
        <span class="brand-tag">5to Semestre</span>
      </div>
    </a>

    <!-- Nav Links (Desktop) -->
    <div class="nav-links">
      <a href="#inicio" class="nav-link">Inicio</a>
      <a href="#proyectos" class="nav-link">Proyectos</a>
      <a href="#sobre-mi" class="nav-link">Sobre Mí</a>
      <a href="#habilidades" class="nav-link">Habilidades</a>
      <a href="#trayectoria" class="nav-link timeline-tag">
        <span class="sparkle">✦</span> Línea de Tiempo
      </a>
      <a href="#contacto" class="nav-link">Contacto</a>
    </div>

    <!-- Actions (GitHub & CV Modal Button) -->
    <div class="nav-actions">
      <a 
        href="https://github.com/fernandoJSiles" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="icon-btn" 
        title="Perfil de GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>

      <!-- Button triggering the CV Modal -->
      <button 
        type="button" 
        class="btn-cv-nav js-open-cv-modal" 
        data-open-cv
        aria-label="Ver Curriculum Vitae"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
        <span>Curriculum</span>
      </button>
    </div>
  </div>
</nav>

<style>
  .navbar-wrapper {
    position: fixed;
    top: 16px;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 0 20px;
    pointer-events: none;
  }

  .navbar-content {
    pointer-events: auto;
    width: 100%;
    max-width: 1120px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 22px;
    background: rgba(8, 10, 15, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.8), 0 0 20px -8px rgba(232, 249, 130, 0.08);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .brand-avatar {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0f131d, #161c28);
    border: 1px solid rgba(232, 249, 130, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 10px rgba(232, 249, 130, 0.18);
  }

  .brand-letters {
    font-size: 0.82rem;
    font-weight: 800;
    color: #E8F982;
    letter-spacing: -0.02em;
    font-family: var(--font-mono);
  }

  .online-indicator {
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 9px;
    height: 9px;
    background: #E8F982;
    border-radius: 50%;
    border: 1.5px solid #000000;
    box-shadow: 0 0 8px #E8F982;
  }

  .brand-info {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .brand-tag {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .nav-link {
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.2s ease;
    padding: 6px 10px;
    border-radius: 8px;
  }

  .nav-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  .nav-link.timeline-tag {
    color: #E8F982;
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    background: rgba(232, 249, 130, 0.08);
    border: 1px solid rgba(232, 249, 130, 0.25);
    padding: 4px 12px;
    border-radius: 9999px;
  }

  .nav-link.timeline-tag:hover {
    background: rgba(232, 249, 130, 0.16);
    box-shadow: 0 0 14px rgba(232, 249, 130, 0.3);
  }

  .sparkle {
    color: #818cf8;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .icon-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border-color: rgba(232, 249, 130, 0.35);
  }

  .btn-cv-nav {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 15px;
    border-radius: 9999px;
    background: rgba(232, 249, 130, 0.1);
    border: 1px solid rgba(232, 249, 130, 0.5);
    color: #E8F982;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 0 12px -3px rgba(232, 249, 130, 0.25);
    transition: all 0.2s ease;
    font-family: var(--font-sans);
  }

  .btn-cv-nav:hover {
    background: rgba(232, 249, 130, 0.22);
    color: #ffffff;
    box-shadow: 0 0 20px rgba(232, 249, 130, 0.45);
    transform: translateY(-1px);
  }

  @media (max-width: 920px) {
    .nav-links {
      display: none;
    }
  }
</style>
